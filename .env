# Global Variables
NODE_ENV=development

# Ports
API_GATEWAY_PORT=3000
INVENTORY_SERVICE_PORT=4000
ORDER_SERVICE_PORT=4001
PAYMENT_SERVICE_PORT=4002
RABBITMQ_UI_PORT=15672
RABBITMQ_PORT=5672

# MongoDB Config
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=inventory

# PostgreSQL Config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB_ORDERS=orders
POSTGRES_DB_PAYMENTS=payments

# RabbitMQ Config
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Internal Networking
DOCKER_NETWORK=oms_network
